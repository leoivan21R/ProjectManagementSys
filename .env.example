# ==============================================================================
# PROJECT MANAGER SYSTEM (PMS) - VARIABLES DE ENTORNO
# ==============================================================================

# Entorno
NODE_ENV=development
PORT=3000

# Conexión opcional con Supabase Cloud / PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Configuración opcional de correo (Resend / SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
